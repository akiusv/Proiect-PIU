<Window x:Class="InterfataWPF.VehiculeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrare Vehicule" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="AlternatingRowBackground" Value="#E9ECEF"/>
            <Setter Property="RowBackground" Value="White"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="HeadersVisibility" Value="Column"/>

            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Label x:Name="lblMarca" Content="Marca:"/>
            <TextBox x:Name="txtMarca"/>
            <Label x:Name="lblModel" Content="Model:"/>
            <TextBox x:Name="txtModel"/>
            <Label x:Name="lblAn" Content="An:"/>
            <TextBox x:Name="txtAn"/>
            <Label x:Name="lblKm" Content="Kilometri:"/>
            <TextBox x:Name="txtKm"/>

            <Label Content="Culoare:" FontWeight="Bold" Margin="0,10,0,0"/>
            <WrapPanel Margin="5">
                <RadioButton x:Name="rbAlb" Content="Alb" IsChecked="True" Margin="0,0,10,5"/>
                <RadioButton x:Name="rbNegru" Content="Negru" Margin="0,0,10,5"/>
                <RadioButton x:Name="rbRosu" Content="Roșu" Margin="0,0,10,5"/>
                <RadioButton x:Name="rbAlbastru" Content="Albastru" Margin="0,0,10,5"/>
                <RadioButton x:Name="rbGri" Content="Gri" Margin="0,0,10,5"/>
            </WrapPanel>

            <Label Content="Opțiuni Extra:" FontWeight="Bold" Margin="0,10,0,0"/>
            <CheckBox x:Name="chkAC" Content="Aer Condiționat" Margin="5,2"/>
            <CheckBox x:Name="chkNav" Content="Navigație GPS" Margin="5,2"/>

            <Label x:Name="lblEroare" Foreground="Red" FontWeight="Bold" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Adaugă" Click="BtnAdauga_Click" Background="#2E7D32" Foreground="White"/>
                <Button Content="Modifică" Click="BtnModifica_Click" Background="#F57C00" Foreground="White"/>
                <Button Content="Șterge" Click="BtnSterge_Click" Background="#D32F2F" Foreground="White"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="dgVehicule" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgVehicule_SelectionChanged" Margin="10">
            <DataGrid.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="8" Direction="315" Opacity="0.25"/>
            </DataGrid.Effect>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="Auto"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="Auto"/>
                <DataGridTextColumn Header="An" Binding="{Binding An}" Width="60"/>
                <DataGridTextColumn Header="Kilometri" Binding="{Binding Kilometri}" Width="70"/>
                <DataGridTextColumn Header="Culoare" Binding="{Binding CuloareVehicul}" Width="Auto"/>
                <DataGridTextColumn Header="Opțiuni" Binding="{Binding Optiuni}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>