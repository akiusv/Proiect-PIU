<Window x:Class="InterfataWPF.VehiculeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administrare Vehicule (CRUD Complet - Tema 13)" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Label Content="Marca:"/>
            <TextBox x:Name="txtMarca"/>
            <Label Content="Model:"/>
            <TextBox x:Name="txtModel"/>
            <Label Content="An:"/>
            <TextBox x:Name="txtAn"/>
            <Label Content="Kilometri:"/>
            <TextBox x:Name="txtKm"/>

            <Label Content="Culoare:" FontWeight="Bold" Margin="0,10,0,0"/>
            <WrapPanel Margin="5">
                <RadioButton x:Name="rbAlb" Content="Alb" IsChecked="True" Margin="0,0,10,5"/>
                <RadioButton x:Name="rbNegru" Content="Negru" Margin="0,0,10,5"/>
                <RadioButton x:Name="rbRosu" Content="Roșu" Margin="0,0,10,5"/>
            </WrapPanel>

            <Label Content="Opțiuni:" FontWeight="Bold" Margin="0,10,0,0"/>
            <CheckBox x:Name="chkAC" Content="Aer Condiționat" Margin="5,2"/>
            <CheckBox x:Name="chkNav" Content="Navigație GPS" Margin="5,2"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Adaugă" Click="BtnAdauga_Click" Background="#4CAF50" Foreground="White" Padding="5" Margin="2"/>
                <Button Content="Modifică" Click="BtnModifica_Click" Background="#FF9800" Foreground="White" Padding="5" Margin="2"/>
                <Button Content="Șterge" Click="BtnSterge_Click" Background="#F44336" Foreground="White" Padding="5" Margin="2"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="dgVehicule" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgVehicule_SelectionChanged" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="*"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="An" Binding="{Binding An}" Width="0.5*"/>
                <DataGridTextColumn Header="Kilometri" Binding="{Binding Kilometri}" Width="0.8*"/>
                <DataGridTextColumn Header="Culoare" Binding="{Binding CuloareVehicul}" Width="*"/>
                <DataGridTextColumn Header="Opțiuni" Binding="{Binding Optiuni}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>