<Window x:Class="InterfataWPF.JoburiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfataWPF"
        mc:Ignorable="d"
        Title="JoburiWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="AlternatingRowBackground" Value="#E9ECEF"/>
            <Setter Property="RowBackground" Value="White"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="HeadersVisibility" Value="Column"/>

            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">
                <Label Content="Șofer:"/>
                <ComboBox x:Name="cmbSoferi" DisplayMemberPath="Nume"/>
                <Label Content="Vehicul:"/>
                <ComboBox x:Name="cmbVehicule" DisplayMemberPath="Marca"/>
                <Label Content="Client:"/>
                <ComboBox x:Name="cmbClienti" DisplayMemberPath="Nume"/>

                <Label Content="Plecare:"/>
                <TextBox x:Name="txtPlecare"/>
                <Label Content="Destinație:"/>
                <TextBox x:Name="txtDestinatie"/>
                <Label Content="Distanță (km):"/>
                <TextBox x:Name="txtDistanta"/>

                <Label Content="Start (Data / Ora):"/>
                <StackPanel Orientation="Horizontal">
                    <DatePicker x:Name="dpStart" Width="100"/>
                    <TextBox x:Name="txtOraStart" Width="40" Text="08:00" Margin="5,0,0,0"/>
                </StackPanel>

                <Label Content="Final (Data / Ora):"/>
                <StackPanel Orientation="Horizontal">
                    <DatePicker x:Name="dpFinal" Width="100"/>
                    <TextBox x:Name="txtOraFinal" Width="40" Text="16:00" Margin="5,0,0,0"/>
                </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Adaugă" Click="BtnAdauga_Click" Background="#2E7D32" Foreground="White"/>
                <Button Content="Modifică" Click="BtnModifica_Click" Background="#F57C00" Foreground="White"/>
                <Button Content="Șterge" Click="BtnSterge_Click" Background="#D32F2F" Foreground="White"/>
            </StackPanel>
        </StackPanel>

            <DataGrid x:Name="dgJoburi" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgJoburi_SelectionChanged" Margin="10">
            <DataGrid.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="315" Opacity="0.15"/>
            </DataGrid.Effect>
            <DataGrid.Columns>
                    <DataGridTextColumn Header="Plecare" Binding="{Binding PunctPlecare}" Width="*"/>
                    <DataGridTextColumn Header="Destinație" Binding="{Binding PunctDestinatie}" Width="*"/>
                    <DataGridTextColumn Header="Șofer" Binding="{Binding SoferAlocat.Nume}" Width="*"/>
                    <DataGridTextColumn Header="Data Start" Binding="{Binding DataIncepere, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Window>