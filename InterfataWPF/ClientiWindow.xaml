<Window x:Class="InterfataWPF.ClientiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfataWPF"
        mc:Ignorable="d"
        Title="ClientiWindow" Height="450" Width="800">
    <Window.Resources>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="AlternatingRowBackground" Value="#E9ECEF"/>
            <Setter Property="RowBackground" Value="White"/>

            <Setter Property="Background" Value="White"/>

            <Setter Property="HeadersVisibility" Value="Column"/>

            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">
                <Label Content="Nume:"/>
                <TextBox x:Name="txtNume"/>
                <Label Content="Prenume:"/>
                <TextBox x:Name="txtPrenume"/>
                <Label Content="Vârsta:"/>
                <TextBox x:Name="txtVarsta"/>
                <Label Content="Telefon:"/>
                <TextBox x:Name="txtTelefon"/>
                <Label Content="Firma:"/>
                <TextBox x:Name="txtFirma"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="Adaugă" Click="BtnAdauga_Click" Background="#2E7D32" Foreground="White"/>
                <Button Content="Modifică" Click="BtnModifica_Click" Background="#F57C00" Foreground="White"/>
                <Button Content="Șterge" Click="BtnSterge_Click" Background="#D32F2F" Foreground="White"/>
            </StackPanel>
        </StackPanel>

            <DataGrid x:Name="dgClienti" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgClienti_SelectionChanged" Margin="10">
            <DataGrid.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="8" Direction="315" Opacity="0.25"/>
            </DataGrid.Effect>

            <DataGrid.Columns>
                    <DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="*"/>
                    <DataGridTextColumn Header="Prenume" Binding="{Binding Prenume}" Width="*"/>
                    <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="1.5*"/>
                    <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Window>